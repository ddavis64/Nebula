PKI:
  ca: key
  cert: key
  key: key

static_host_map:
  "10.1.0.1": 
  - "98.169.84.229:4242"

lighthouse:
  am_lighthouse: false
  hosts:
    - "10.1.0.1"
  interval: 60

listen:
  host: "[::]"
  port: 0

punchy:
  punch: true

relay:
  am_relay: false
  use_relays: true

tun:
  disabled: false
  dev: nebula1
  drop_local_broadcast: true
  drop_multicast: true
  tx_queue: 500
  mtu: 1300

logging:
  level: info
  format: text

firewall:
  outbound_action: drop
  inbound_action: drop

conntrack:
  tcp_timeout: 12m
  udp_timeout: 3m
  default_timeout: 10m

outbound:
- port: any
  proto: any
  host: any

inbound:
- port: any
  proto: any
  host: any
